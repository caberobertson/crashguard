# CrashGuard host configuration template.
#
#   cd host
#   cp .env.example .env
#   then fill in the values below
#
# .env is excluded by .gitignore and must never be committed.
# Defaults shown are the ones the code falls back to, so blank
# entries below are optional unless marked REQUIRED.

# --- Twilio Programmable Voice and Messaging (REQUIRED) -------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_CONTACT_NUMBER=

# --- Public HTTPS URL that Twilio webhooks reach (REQUIRED) ---------
# Paste the https forwarding URL that "ngrok http 5000" prints.
# Browser geolocation needs HTTPS, so the plain local address will
# not capture position.
PUBLIC_BASE_URL=

# --- Anthropic (REQUIRED) -------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Demonstration safety flags -------------------------------------
# DEMO_MODE=1 makes the agent state plainly that no real emergency
# exists if it is asked. Leave it on for the competition demo.
DEMO_MODE=1
DRY_RUN=0
MOCK_AI=0

# --- Speech and voice -----------------------------------------------
TTS_VOICE=Google.en-US-Neural2-F
SPEECH_LANG=en-US
SPEECH_TIMEOUT=1

# --- Behaviour -------------------------------------------------------
PORT=5000
TRIGGER_COOLDOWN_S=60
HISTORY_TURNS=6
DOC_OFFER_AFTER_TURNS=3
SCENE_WAIT_S=3
VICTIM_PROFILE=victim_profile.json

# --- Email delivery of the incident report (optional) ----------------
# Leave blank to deliver reports by SMS only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL=
